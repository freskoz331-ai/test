# Алгоритм построения КНФ для функции от трёх переменных

def build_knf_3vars(func):
    """
    Строит КНФ для логической функции от трёх переменных.
    func - функция от трёх аргументов (x, y, z)
    """
    clauses = []
    for x in [0, 1]:
        for y in [0, 1]:
            for z in [0, 1]:
                f = func(x, y, z)
                if not f:
                    clause = []
                    if x == 0:
                        clause.append("x")
                    else:
                        clause.append("¬x")
                    if y == 0:
                        clause.append("y")
                    else:
                        clause.append("¬y")
                    if z == 0:
                        clause.append("z")
                    else:
                        clause.append("¬z")
                    clauses.append("(" + " ∨ ".join(clause) + ")")
    return " ∧ ".join(clauses)

# Пример использования
f = lambda x, y, z: x and (not y)
print("КНФ для x ∧ ¬y:", build_knf_3vars(f))
# КНФ для x ∧ ¬y: (x ∨ y ∨ z) ∧ (x ∨ y ∨ ¬z) ∧ (x ∨ ¬y ∨ z) ∧ (x ∨ ¬y ∨ ¬z) ∧ (¬x ∨ y ∨ z) ∧ (¬x ∨ y ∨ ¬z) ∧ (¬x ∨ ¬y ∨ z) ∧ (¬x ∨ ¬y ∨ ¬z)

