# Универсальный алгоритм построения ДНФ и КНФ по таблице истинности

def build_dnf_knf_from_table(func, var_names):
    """
    Строит ДНФ и КНФ для функции по таблице истинности.
    func - функция от переменных
    var_names - список имён переменных
    """
    n = len(var_names)
    terms = []
    clauses = []
    
    # Генерируем все наборы
    for i in range(2**n):
        # Преобразуем i в бинарный набор значений
        values = [(i >> (n - 1 - j)) & 1 for j in range(n)]
        
        f = func(*values)
        
        if f:
            # ДНФ: элементарная конъюнкция
            term = []
            for j in range(n):
                if values[j] == 0:
                    term.append("¬" + var_names[j])
                else:
                    term.append(var_names[j])
            terms.append(" ∧ ".join(term))
        
        if not f:
            # КНФ: элементарная дизъюнкция
            clause = []
            for j in range(n):
                if values[j] == 0:
                    clause.append(var_names[j])
                else:
                    clause.append("¬" + var_names[j])
            clauses.append("(" + " ∨ ".join(clause) + ")")
    
    dnf = " ∨ ".join(terms) if terms else "0"
    knf = " ∧ ".join(clauses) if clauses else "1"
    
    # Проверка корректности
    dnf_correct = True
    knf_correct = True
    
    for i in range(2**n):
        values = [(i >> (n - 1 - j)) & 1 for j in range(n)]
        
        # Вычисляем по ДНФ
        if dnf == "0":
            dnf_val = False
        else:
            # Упрощённая проверка (полная нужна парсинг)
            dnf_val = None
        
        # Вычисляем по КНФ
        if knf == "1":
            knf_val = True
        else:
            knf_val = None
        
        # Сравниваем с оригинальной функцией
        if dnf_val is not None and dnf_val != f:
            dnf_correct = False
        if knf_val is not None and knf_val != f:
            knf_correct = False
    
    return dnf, knf

# Пример: f(x,y,z) = (x ∧ y) ∨ z
f = lambda x, y, z: (x and y) or z
dnf, knf = build_dnf_knf_from_table(f, ["x", "y", "z"])
print("ДНФ:", dnf)
print("КНФ:", knf)
# ДНФ: (¬x ∧ ¬y ∧ z) ∨ (x ∧ ¬y ∧ z) ∨ (x ∧ y ∧ ¬z) ∨ (x ∧ y ∧ z)
# КНФ: (x ∨ y ∨ z) ∧ (x ∨ ¬y ∨ z) ∧ (¬x ∨ y ∨ z) ∧ (¬x ∨ ¬y ∨ z)

