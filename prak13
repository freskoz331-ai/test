# Сравнение размеров ДНФ и КНФ для одной функции

def count_components(formula):
    """Считает количество элементарных компонентов в ДНФ/КНФ"""
    if "∨" in formula:
        return len(formula.split("∨"))
    if "∧" in formula:
        return len(formula.split("∧"))
    return 1

