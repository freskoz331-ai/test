# Алгоритм построения ДНФ для функции от двух переменных

def build_dnf_2vars(func):
    """
    Строит ДНФ для логической функции от двух переменных.
    func - функция от двух аргументов (x, y)
    """
    terms = []
    for x in [0, 1]:
        for y in [0, 1]:
            f = func(x, y)
            if f:
                term = []
                if x == 0:
                    term.append("¬x")
                else:
                    term.append("x")
                if y == 0:
                    term.append("¬y")
                else:
                    term.append("y")
                terms.append(" ∧ ".join(term))
    return " ∨ ".join(terms)

# Пример использования
f = lambda x, y: (not x) or y
print("ДНФ для ¬x ∨ y:", build_dnf_2vars(f))
# ДНФ для ¬x ∨ y: (¬x ∧ ¬y) ∨ (¬x ∧ y) ∨ (x ∧ y)

